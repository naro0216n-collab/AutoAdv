    {
      "id": "instruction",
      "text": "無音声の主人公は、AutoAdv側でIrodori TTSを指定して検証してください。",
      "advance_mode": "text",
      "use_tts": false,
      "foreground_voice": false
    },
    {
      "id": "protagonist-1",
      "text": "これは無音声の台詞です。",
