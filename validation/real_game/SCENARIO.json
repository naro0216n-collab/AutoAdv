      "use_tts": true,
      "foreground_voice": false
    },
    {
      "id": "protagonist-2",
      "text": "この文章はIrodori TTSの確認に使用します。",
      "advance_mode": "audio",
      "use_tts": true,
      "foreground_voice": false
