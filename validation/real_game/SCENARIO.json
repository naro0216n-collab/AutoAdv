    {
      "id": "normal-001",
      "text": "えっ嘘でしょ。",
      "advance_mode": "audio",
      "use_tts": false,
      "foreground_voice": true,
      "foreground_file": "audio/voice/normal_001.wav"
    },
    {
      "id": "normal-017",
      "text": "あっベルが鳴ってる。",
      "advance_mode": "audio",
      "use_tts": false,
      "foreground_voice": true,
      "foreground_file": "audio/voice/normal_017.wav"
    },
    {
      "id": "normal-022",
      "text": "猫はにゃーにゃーと鳴く。",
      "advance_mode": "audio",
      "use_tts": false,
      "foreground_voice": true,
      "foreground_file": "audio/voice/normal_022.wav"
    },
    {
